<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_mpc_wbc_cpp_controller</name>
  <version>0.0.2</version>
  <description>
    Disabled-by-default C++ controller skeleton and control algorithm test package.
    This package does not claim real robot torque execution or hardware torque enablement.
  </description>
  <maintainer email="zanshi-dev@users.noreply.github.com">zanshi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
